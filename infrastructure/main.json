{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "12488337956082157325"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "namePrefix": {
      "type": "string",
      "defaultValue": "openemr",
      "metadata": {
        "description": "Prefix for resource names"
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "metadata": {
        "description": "Environment name (dev, staging, prod)"
      }
    },
    "openEmrImage": {
      "type": "string",
      "defaultValue": "openemr/openemr:latest",
      "metadata": {
        "description": "OpenEMR container image"
      }
    },
    "mysqlAdminLogin": {
      "type": "string",
      "defaultValue": "openemradmin",
      "metadata": {
        "description": "MySQL administrator login"
      }
    },
    "mysqlAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "MySQL administrator password"
      }
    },
    "allowPublicAccess": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Allow public access to MySQL"
      }
    },
    "vnetCidr": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Virtual network CIDR"
      }
    },
    "containerAppsSubnetCidr": {
      "type": "string",
      "defaultValue": "10.0.1.0/24",
      "metadata": {
        "description": "Container Apps subnet CIDR"
      }
    },
    "mysqlSubnetCidr": {
      "type": "string",
      "defaultValue": "10.0.2.0/24",
      "metadata": {
        "description": "MySQL subnet CIDR"
      }
    },
    "enableZoneRedundancy": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable zone redundancy"
      }
    },
    "enableTlsIngress": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Enable TLS ingress"
      }
    }
  },
  "variables": {
    "uniqueSuffix": "[uniqueString(resourceGroup().id)]",
    "containerAppEnvName": "[format('{0}-env-{1}-{2}', parameters('namePrefix'), parameters('environment'), variables('uniqueSuffix'))]",
    "containerAppName": "[format('{0}-app-{1}-{2}', parameters('namePrefix'), parameters('environment'), variables('uniqueSuffix'))]",
    "mysqlServerName": "[format('{0}-mysql-{1}-{2}', parameters('namePrefix'), parameters('environment'), variables('uniqueSuffix'))]",
    "logAnalyticsName": "[format('{0}-logs-{1}-{2}', parameters('namePrefix'), parameters('environment'), variables('uniqueSuffix'))]",
    "appInsightsName": "[format('{0}-insights-{1}-{2}', parameters('namePrefix'), parameters('environment'), variables('uniqueSuffix'))]",
    "vnetName": "[format('{0}-vnet-{1}-{2}', parameters('namePrefix'), parameters('environment'), variables('uniqueSuffix'))]",
    "mysqlDatabaseName": "openemr"
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30,
        "features": {
          "enableLogAccessUsingOnlyResourcePermissions": true
        },
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "IngestionMode": "LogAnalytics",
        "publicNetworkAccessForIngestion": "Enabled",
        "publicNetworkAccessForQuery": "Enabled"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ]
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetCidr')]"
          ]
        },
        "subnets": [
          {
            "name": "container-apps-subnet",
            "properties": {
              "addressPrefix": "[parameters('containerAppsSubnetCidr')]",
              "delegations": [
                {
                  "name": "Microsoft.App.environments",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          },
          {
            "name": "mysql-subnet",
            "properties": {
              "addressPrefix": "[parameters('mysqlSubnetCidr')]",
              "delegations": [
                {
                  "name": "Microsoft.DBforMySQL.flexibleServers",
                  "properties": {
                    "serviceName": "Microsoft.DBforMySQL/flexibleServers"
                  }
                }
              ]
            }
          }
        ]
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      }
    },
    {
      "condition": "[not(parameters('allowPublicAccess'))]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}.mysql.database.azure.com', parameters('namePrefix'))]",
      "location": "global",
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      }
    },
    {
      "condition": "[not(parameters('allowPublicAccess'))]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', format('{0}.mysql.database.azure.com', parameters('namePrefix')), format('{0}-link', variables('vnetName')))]",
      "location": "global",
      "properties": {
        "registrationEnabled": false,
        "virtualNetwork": {
          "id": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', format('{0}.mysql.database.azure.com', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers",
      "apiVersion": "2023-12-30",
      "name": "[variables('mysqlServerName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_B2s",
        "tier": "Burstable"
      },
      "properties": {
        "administratorLogin": "[parameters('mysqlAdminLogin')]",
        "administratorLoginPassword": "[parameters('mysqlAdminPassword')]",
        "version": "8.0.21",
        "storage": {
          "storageSizeGB": 32,
          "iops": 120,
          "autoGrow": "Enabled",
          "logOnDisk": "Disabled"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "[if(parameters('enableZoneRedundancy'), 'Enabled', 'Disabled')]"
        },
        "highAvailability": {
          "mode": "[if(parameters('enableZoneRedundancy'), 'ZoneRedundant', 'Disabled')]"
        },
        "network": {
          "delegatedSubnetResourceId": "[if(parameters('allowPublicAccess'), null(), format('{0}/subnets/mysql-subnet', resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))))]",
          "privateDnsZoneResourceId": "[if(parameters('allowPublicAccess'), null(), resourceId('Microsoft.Network/privateDnsZones', format('{0}.mysql.database.azure.com', parameters('namePrefix'))))]",
          "publicNetworkAccess": "[if(parameters('allowPublicAccess'), 'Enabled', 'Disabled')]"
        },
        "createMode": "Default"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', format('{0}.mysql.database.azure.com', parameters('namePrefix')))]",
        "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', format('{0}.mysql.database.azure.com', parameters('namePrefix')), format('{0}-link', variables('vnetName')))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.DBforMySQL/flexibleServers/databases",
      "apiVersion": "2023-12-30",
      "name": "[format('{0}/{1}', variables('mysqlServerName'), variables('mysqlDatabaseName'))]",
      "properties": {
        "charset": "utf8mb4",
        "collation": "utf8mb4_unicode_ci"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2025-01-01",
      "name": "[variables('containerAppEnvName')]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName')), '2023-09-01').primarySharedKey]"
          }
        },
        "vnetConfiguration": {
          "infrastructureSubnetId": "[format('{0}/subnets/container-apps-subnet', resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')))]",
          "internal": false
        },
        "zoneRedundant": "[parameters('enableZoneRedundancy')]",
        "daprAIConnectionString": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]",
        "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2025-01-01",
      "name": "[variables('containerAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 80,
            "transport": "auto",
            "allowInsecure": "[not(parameters('enableTlsIngress'))]",
            "traffic": [
              {
                "weight": 100,
                "latestRevision": true
              }
            ]
          },
          "secrets": [
            {
              "name": "mysql-password",
              "value": "[parameters('mysqlAdminPassword')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "openemr",
              "image": "[parameters('openEmrImage')]",
              "resources": {
                "cpu": 1,
                "memory": "2Gi"
              },
              "env": [
                {
                  "name": "MYSQL_HOST",
                  "value": "[reference(resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName')), '2023-12-30').fullyQualifiedDomainName]"
                },
                {
                  "name": "MYSQL_ROOT_PASS",
                  "secretRef": "mysql-password"
                },
                {
                  "name": "MYSQL_USER",
                  "value": "[parameters('mysqlAdminLogin')]"
                },
                {
                  "name": "MYSQL_PASS",
                  "secretRef": "mysql-password"
                },
                {
                  "name": "MYSQL_DATABASE",
                  "value": "[variables('mysqlDatabaseName')]"
                },
                {
                  "name": "OE_USER",
                  "value": "admin"
                },
                {
                  "name": "OE_PASS",
                  "value": "admin123"
                },
                {
                  "name": "EASY_DEV_MODE",
                  "value": "[if(equals(parameters('environment'), 'dev'), 'yes', 'no')]"
                },
                {
                  "name": "EASY_DEV_MODE_NEW",
                  "value": "[if(equals(parameters('environment'), 'dev'), 'yes', 'no')]"
                },
                {
                  "name": "DEVELOPER_TOOLS",
                  "value": "[if(equals(parameters('environment'), 'dev'), 'yes', 'no')]"
                },
                {
                  "name": "XDEBUG_ON",
                  "value": "[if(equals(parameters('environment'), 'dev'), '1', '0')]"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
                }
              ],
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/",
                    "port": 80,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 120,
                  "periodSeconds": 30,
                  "timeoutSeconds": 10,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/",
                    "port": 80,
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5,
                  "failureThreshold": 3
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": "[if(equals(parameters('environment'), 'prod'), 10, 3)]",
            "rules": [
              {
                "name": "http-scaling",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              },
              {
                "name": "cpu-scaling",
                "custom": {
                  "type": "cpu",
                  "metadata": {
                    "type": "Utilization",
                    "value": "70"
                  }
                }
              }
            ]
          }
        }
      },
      "tags": {
        "Environment": "[parameters('environment')]",
        "Application": "OpenEMR"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('containerAppEnvName'))]",
        "[resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName'))]"
      ]
    }
  ],
  "outputs": {
    "containerAppFqdn": {
      "type": "string",
      "metadata": {
        "description": "Container App FQDN"
      },
      "value": "[reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2025-01-01').configuration.ingress.fqdn]"
    },
    "mysqlServerFqdn": {
      "type": "string",
      "metadata": {
        "description": "MySQL Server FQDN"
      },
      "value": "[reference(resourceId('Microsoft.DBforMySQL/flexibleServers', variables('mysqlServerName')), '2023-12-30').fullyQualifiedDomainName]"
    },
    "appInsightsConnectionString": {
      "type": "string",
      "metadata": {
        "description": "Application Insights Connection String"
      },
      "value": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics Workspace ID"
      },
      "value": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
    },
    "openEmrUrl": {
      "type": "string",
      "metadata": {
        "description": "OpenEMR Application URL"
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', variables('containerAppName')), '2025-01-01').configuration.ingress.fqdn)]"
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource Group Name"
      },
      "value": "[resourceGroup().name]"
    },
    "containerAppEnvironmentName": {
      "type": "string",
      "metadata": {
        "description": "Container Apps Environment Name"
      },
      "value": "[variables('containerAppEnvName')]"
    },
    "mysqlDatabaseName": {
      "type": "string",
      "metadata": {
        "description": "MySQL Database Name"
      },
      "value": "[variables('mysqlDatabaseName')]"
    }
  }
}